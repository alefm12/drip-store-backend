# Servidor
PORT=3000
# URL pública usada para montar o link das imagens (opcional)
# APP_URL=http://localhost:3000

# Banco de dados MySQL
DB_HOST=127.0.0.1
# 3307 = porta do MySQL do docker-compose (use 3306 para um MySQL instalado na máquina)
DB_PORT=3307
DB_USER=root
DB_PASS=root
DB_NAME=drip_store

# JWT
JWT_SECRET=troque-esta-chave-secreta
JWT_EXPIRES_IN=1d
